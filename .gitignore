```gitignore
# =========================
# DEPENDENCIAS
# =========================
node_modules/
**/node_modules/
.pnp
.pnp.js

# =========================
# PRUEBAS Y COMPILACIÓN
# =========================
coverage/
build/
dist/

# =========================
# VARIABLES DE ENTORNO Y SECRETOS
# =========================
.env
.env.*
!.env.example
server/.env

# =========================
# ARCHIVOS TEMPORALES
# =========================
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# EDITORES
# =========================
.vscode/
.idea/

# =========================
# SERVIDOR ORVAN
# =========================
server/uploads/*
!server/uploads/.gitkeep
