# Copiar este archivo como ".env" y completar. El ".env" NUNCA se sube a Git.
PORT=4000

# MySQL de ESTA computadora
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=poner_la_clave_de_mysql

# Firma de las sesiones: una frase larga y propia (no dejar la de ejemplo)
JWT_SECRET=cambiar_por_una_frase_larga_y_dificil_de_adivinar

# Administrador que se crea con npm run db:init
ADMIN_EMAIL=admin@orvan.com
ADMIN_PASSWORD=poner_una_clave_segura_con_numeros

# Correo: Gmail del estudio + CONTRASEÑA DE APLICACIÓN (no la clave normal), sin espacios
MAIL_USER=orvanstudio0@gmail.com
MAIL_PASS=poner_la_contrasena_de_aplicacion_sin_espacios
